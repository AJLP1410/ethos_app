platform :ios, '15.0'

# Lógica mejorada para encontrar el SDK de Flutter
def find_flutter_root
  # Plan A: Usar la variable de entorno del sistema (Codemagic la tiene)
  return ENV['FLUTTER_ROOT'] if ENV['FLUTTER_ROOT']

  # Plan B: Leer Generated.xcconfig con limpieza de caracteres de Windows
  config_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  if File.exist?(config_path)
    File.foreach(config_path) do |line|
      # Esta Regex es más flexible con espacios y finales de línea
      if line =~ /FLUTTER_ROOT\s*=\s*(.*)/
        path = $1.strip.gsub(/['"]/, '') # Limpia comillas y espacios
        return path unless path.empty?
      end
    end
  end
  
  # Si todo falla, error descriptivo
  raise "No se encontró FLUTTER_ROOT. Asegúrate de que el archivo ios/Flutter/Generated.xcconfig existe y no está corrupto."
end

# Cargar podhelper
flutter_root = find_flutter_root
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Forzar iOS 15.0 para Firebase y todos los pods
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end