platform :ios, '15.0'

# Esta es la forma correcta y segura de importar Flutter
flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__)) rescue nil

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  
  # Si flutter_install_all_ios_pods falló arriba, esto lo intenta de nuevo
  # dentro del contexto del target.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Aquí forzamos el 15.0 para que Firestore no moleste
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end