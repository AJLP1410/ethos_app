# Esta línea busca el archivo de dependencias que Flutter genera automáticamente
load File.join(File.dirname(File.realpath(__FILE__)), '..', '.flutter-plugins-dependencies')

platform :ios, '15.0'

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Instalación de los pods de los plugins (Firestore, Auth, etc.)
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Mantenemos el target en 15.0 para evitar el error de Firestore
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end