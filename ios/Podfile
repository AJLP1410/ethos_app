# ESTAS TRES LINEAS SON EL SECRETO
File.open("../.metadata") do |f|
  f.each_line do |line|
    if line =~ /project_type:\s*app/
      require File.expand_path(File.join('..', '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'xcode_backend.sh'), __FILE__) rescue nil
    end
  end
end

platform :ios, '15.0'

# Cargamos las dependencias de los plugins
load File.join(File.dirname(File.realpath(__FILE__)), '..', '.flutter-plugins-dependencies')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Mantenemos nuestro 15.0 forzado
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end